# ─── Cloudinary Image Upload ───────────────────────────────────────────────────
# All teammates must fill these in after cloning the repo.
# Steps:
#   1. Go to https://cloudinary.com and create a FREE account (shared team account recommended)
#   2. Dashboard → Settings → Upload → "Add upload preset" → set Mode to "Unsigned" → Save
#   3. Copy your Cloud Name (top of Dashboard) and the preset name you just created
#   4. Paste below, then rename this file to .env (never commit .env to git)

VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name_here
VITE_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset_here

# ─── API Base URL ──────────────────────────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:5000/api
